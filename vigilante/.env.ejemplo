# Copia este fichero a .env y rellena la clave. El .env NO va al repo.
#   cp .env.ejemplo .env && nano .env

# --- Nextcloud -------------------------------------------------------------
# NC_URL lo fija compose.yml (http://nextcloud_web_1, por dentro de la red).
NC_USUARIO=Yorch
# Contraseña de aplicación, NO la del usuario. Se genera en:
#   Nextcloud -> Ajustes -> Seguridad -> Dispositivos y sesiones -> Crear
NC_CLAVE=
NC_CARPETA=Transcribir

# --- Transcripción ---------------------------------------------------------
# tiny | base | small | medium | large-v3
WHISPER_MODEL=small
# Fija el idioma en vez de detectarlo. Vacío = detección automática.
IDIOMA=es

# --- Vigilancia ------------------------------------------------------------
# Cada cuánto mira la carpeta (segundos).
INTERVALO=60
# Antigüedad mínima de un fichero para tocarlo, por si aún se está subiendo.
EDAD_MINIMA=30
# Días que se guarda el original en hechos/ antes de borrarlo. 0 = no purgar.
DIAS_RETENCION=30
# Corta una transcripción que se haya quedado colgada más de estas horas.
LIMITE_HORAS=12
